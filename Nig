local verifying = false

VerifyBtn.MouseButton1Click:Connect(function()
    if verifying then return end
    local key = KeyInput.Text:gsub("%s+", "")
    if key == "" then
        StatusLabel.Text = "⚠️ Please enter a key first"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 180, 60)
        return
    end

    verifying = true
    VerifyBtn.Text = "⏳ Verifying..."
    VerifyBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
    StatusLabel.Text = "Contacting server..."
    StatusLabel.TextColor3 = Color3.fromRGB(180, 180, 190)

    task.spawn(function()
        local valid, message = verifyKey(key)
        if valid then
            saveKey(key)
            StatusLabel.Text = "✅ " .. tostring(message)
            StatusLabel.TextColor3 = Color3.fromRGB(80, 220, 120)
            VerifyBtn.Text = "✅ Success!"
            VerifyBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80)

            task.wait(1)
            KeyFrame.Visible = false

            print("[KeyForge] " .. tostring(message))
            notify("✅ Key Accepted", tostring(message))

            -- ═══════════════════════════════════════════
            -- ✅ ضع السكربت المحمي هنا
            -- ═══════════════════════════════════════════
            -- loadstring(game:HttpGet("https://your-script-url.lua"))()
            -- ═══════════════════════════════════════════

            -- بدء polling للرسائل
            pollReplies()
            task.spawn(function() 
                while task.wait(5) do 
                    pcall(pollReplies) 
                end 
            end)

        else
            StatusLabel.Text = "❌ " .. tostring(message)
            StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
            VerifyBtn.Text = "🔓 Verify"
            VerifyBtn.BackgroundColor3 = Color3.fromRGB(88, 101, 242)
            verifying = false
        end
    end)
end)

