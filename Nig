local lastSeen = nil
local primed = false
local shownMessages = {}

local function decode(res)
    if not res then return nil, "no response" end
    local okJ, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
    if not okJ then return nil, "bad JSON (HTTP " .. tostring(res.StatusCode) .. ")" end
    if res.StatusCode and res.StatusCode >= 400 then
        return nil, "HTTP " .. res.StatusCode .. ": " .. tostring(data.message)
    end
    return data
end

local function label(sender)
    if sender == "owner" then return "👑 Owner" 
    elseif sender == "ai" then return "🤖 AI Support" 
    elseif sender == "player" or sender == "user" then return "👤 You"
    end
    return "💬 Support"
end

local function sendSupport(text, callback)
    if not httpRequest then 
        if callback then callback(false, nil) end
        return 
    end
    task.spawn(function()
        local ok, res = pcall(httpRequest, {
            Url = MSG_URL, Method = "POST",
            Headers = { ["Content-Type"] = "application/json", ["Authorization"] = "Bearer " .. API_KEY },
            Body = HttpService:JSONEncode({
                project_id = PROJECT_ID,
                player_user_id = LocalPlayer.UserId,
                player_name = LocalPlayer.Name,
                message = text,
            }),
        })
        if not ok then 
            if callback then callback(false, nil) end
            return 
        end
        local data, err = decode(res)
        if not data then 
            warn("[Support] " .. tostring(err))
            if callback then callback(false, nil) end
            return 
        end
        if callback then callback(true, data) end
    end)
end

local function pollReplies()
    if not httpRequest then return end
    local url = MSG_URL .. "?project_id=" .. PROJECT_ID .. "&player_user_id=" .. LocalPlayer.UserId
    if lastSeen then url = url .. "&since=" .. HttpService:UrlEncode(lastSeen) end
    local ok, res = pcall(httpRequest, { 
        Url = url, Method = "GET", 
        Headers = { ["Authorization"] = "Bearer " .. API_KEY } 
    })
    if not ok then return end
    local data = decode(res)
    if not data then return end
    for _, m in ipairs(data.messages or {}) do
        lastSeen = m.created_at
        if primed then
            local who = label(m.sender)
            print("[" .. who .. "] " .. tostring(m.message))
            notify(who, tostring(m.message))
        end
    end
    primed = true
end

