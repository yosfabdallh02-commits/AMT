--// Verify
verify.MouseButton1Click:Connect(function()
    local key = box.Text

    if key == "" then
        status.Text = "❌ Please enter a key."
        return
    end

    if not httpRequest then
        status.Text = "❌ HTTP requests are not supported."
        return
    end

    status.Text = "Checking key..."

    local success, response = pcall(function()
        return httpRequest({
            Url = API_URL,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                ["Authorization"] = "Bearer " .. API_KEY
            },
            Body = HttpService:JSONEncode({
                project_id = PROJECT_ID,
                key = key,
                hwid = HWID
            })
        })
    end)

    if not success or not response then
        status.Text = "❌ Could not reach key server."
        warn("[KeyForge] Request failed: " .. tostring(response))
        return
    end

    local body = response.Body or response.body or ""

    local decoded, data = pcall(function()
        return HttpService:JSONDecode(body)
    end)

    if not decoded or type(data) ~= "table" then
        status.Text = "❌ Invalid server response."
        return
    end

    if data.valid == true then
        status.Text = "✅ Key verified! Script unlocked."
        print("[KeyForge] " .. tostring(data.message or "Access granted"))

        -- ضع كود السكربت المحمي هنا
        -- مثال:
        -- loadstring(game:HttpGet("https://example.com/script.lua"))()

        task.wait(1)
        gui:Destroy()
    else
        status.Text = "❌ " .. tostring(data.message or "Invalid key.")
    end
end)
