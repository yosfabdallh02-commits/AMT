-- ═══ دوال الطلب ═══
local function getRequest()
    if syn and syn.request then return syn.request end
    if http and http.request then return http.request end
    if http_request then return http_request end
    if request then return request end
    return nil
end

local httpRequest = getRequest()
local HWID = (gethwid and gethwid()) or 
             (game:GetService("RbxAnalyticsService") and game:GetService("RbxAnalyticsService"):GetClientId()) or 
             "UNKNOWN_HWID"

-- ═══ حفظ المفتاح ═══
local function saveKey(key)
    if writefile then pcall(writefile, SAVE_FILE, HttpService:JSONEncode({key = key})) end
end

local function loadKey()
    if readfile and isfile and isfile(SAVE_FILE) then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(SAVE_FILE)) end)
        if ok and data and data.key then return data.key end
    end
    return nil
end

-- ═══ التحقق من المفتاح ═══
local function verifyKey(key)
    if not httpRequest then return false, "Executor missing HTTP" end
    local ok, response = pcall(httpRequest, {
        Url = API_URL, Method = "POST",
        Headers = { ["Content-Type"] = "application/json", ["Authorization"] = "Bearer " .. API_KEY },
        Body = HttpService:JSONEncode({
            project_id = PROJECT_ID, key = key, hwid = HWID,
            roblox_user_id = LocalPlayer.UserId, roblox_username = LocalPlayer.Name,
            roblox_avatar = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. LocalPlayer.UserId .. "&width=150&height=150&format=png",
        }),
    })
    if not ok or not response then return false, "Could not reach key server" end
    local decoded = pcall(function() response = HttpService:JSONDecode(response.Body) end)
    if not decoded then return false, "Invalid server response" end
    return response.valid == true, response.message or "Unknown"
end

-- ═══ إرسال رسالة للدعم ═══
local function sendSupport(text, callback)
    if not httpRequest then return end
    task.spawn(function()
        local ok, res = pcall(httpRequest, {
            Url = MSG_URL, Method = "POST",
            Headers = { ["Content-Type"] = "application/json", ["Authorization"] = "Bearer " .. API_KEY },
            Body = HttpService:JSONEncode({
                project_id = PROJECT_ID,
                player_user_id = LocalPlayer.UserId,
                player_name = LocalPlayer.Name,
                message = text,
            }),
        })
        if not ok or not res then 
            if callback then callback(false, "Connection failed") end
            return 
        end
        local success, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
        if success and data then
            if callback then callback(true, data) end
        else
            if callback then callback(false, "Invalid response") end
        end
    end)
end

-- ═══ جلب الردود ═══
local function fetchReplies(lastSeen, callback)
    if not httpRequest then return end
    task.spawn(function()
        local url = MSG_URL .. "?project_id=" .. PROJECT_ID .. "&player_user_id=" .. LocalPlayer.UserId
        if lastSeen then url = url .. "&since=" .. HttpService:UrlEncode(lastSeen) end
        local ok, res = pcall(httpRequest, {
            Url = url, Method = "GET",
            Headers = { ["Authorization"] = "Bearer " .. API_KEY },
        })
        if not ok or not res then 
            if callback then callback(false, nil) end
            return 
        end
        local success, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
        if success and data then
            if callback then callback(true, data.messages or data.replies or {}) end
        else
            if callback then callback(false, nil) end
        end
    end)
end

