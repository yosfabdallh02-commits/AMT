        MsgBubble.BackgroundColor3 = isUser and Color3.fromRGB(88, 101, 242) 
                                    or (isAI and Color3.fromRGB(45, 45, 60) 
                                    or (isOwner and Color3.fromRGB(200, 100, 40) 
                                    or Color3.fromRGB(45, 45, 60)))
        MsgBubble.TextColor3 = Color3.fromRGB(255, 255, 255)
        MsgBubble.TextSize = 13
        MsgBubble.Font = Enum.Font.Gotham
        MsgBubble.TextWrapped = true
        MsgBubble.TextXAlignment = Enum.TextXAlignment.Left
        MsgBubble.TextYAlignment = Enum.TextYAlignment.Top

        local prefix = isUser and "👤 You: " or (isAI and "🤖 AI: " or (isOwner and "👑 Owner: " or "💬: "))
