        bubblePadding.PaddingLeft = UDim.new(0, 12)
        bubblePadding.PaddingRight = UDim.new(0, 12)
        bubblePadding.Parent = MsgBubble

        MsgBubble.Parent = MsgContainer
        Instance.new("UICorner", MsgBubble).CornerRadius = UDim.new(0, 10)

        -- تمرير للأسفل
        task.wait()
        MessagesFrame.CanvasPosition = Vector2.new(0, MessagesFrame.AbsoluteCanvasSize.Y)
    end

    -- رسالة ترحيب
    addMessage("ai", "Hello " .. LocalPlayer.Name .. "! 👋 I'm your AI support assistant. How can I help you today?", nil)

    -- دالة إرسال
    local sending = false
    local function sendMessage()
        if sending then return end
        local text = MsgInput.Text:gsub("^%s+", ""):gsub("%s+$", "")
        if text == "" then return end

        sending = true
        MsgInput.Text = ""
        addMessage("player", text, nil)

        sendSupport(text, function(success, data)
            sending = false
            if not success then
                addMessage("ai", "⚠️ Connection error. Please try again.", nil)
                return
            end

            -- إظهار ردود فورية إن وجدت
            if data and data.replies then
                for _, r in ipairs(data.replies) do
                    local msgText = r.message or r.text or ""
                    local sender = r.sender or "ai"
                    local msgId = r.id or r.created_at or (tostring(sender) .. msgText)
                    addMessage(sender, msgText, msgId)
                    if r.created_at then lastSeenTime = r.created_at end
                end
            end

            if data and data.reply then
                addMessage("ai", data.reply, nil)
            end

            if data and data.response then
                addMessage("ai", data.response, nil)
            end
        end)
    end

