-- دالة إضافة نص للنتائج
local function addText(text, color)
    local TextLabel = Instance.new("TextLabel")
    TextLabel.Size = UDim2.new(1, -10, 0, 25)
    TextLabel.BackgroundTransparency = 1
    TextLabel.TextColor3 = color or Color3.fromRGB(255, 255, 255)
    TextLabel.TextXAlignment = Enum.TextXAlignment.Left
    TextLabel.Font = Enum.Font.SourceSans
    TextLabel.TextSize = 12
    TextLabel.TextWrapped = true
    TextLabel.Text = text
    TextLabel.LayoutOrder = #ResultsFrame:GetChildren() + 1
    TextLabel.Parent = ResultsFrame
    ResultsFrame.CanvasPosition = Vector2.new(0, ResultsFrame.CanvasSize.Y.Offset)
end

-- دالة إرسال البيانات
local function sendData()
    -- جمع بيانات اللاعب
    local data = {
        playerName = LocalPlayer.Name,
        userId = LocalPlayer.UserId,
        gameId = game.PlaceId,
        gameName = game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name,
        timestamp = os.time(),
        playerCount = #Players:GetPlayers(),
        serverId = game.JobId,
        fps = 60, -- تقدر تغيرها
        ping = 0 -- تقدر تغيرها
    }
    
    addText("📤 جاري إرسال البيانات...", Color3.fromRGB(255, 255, 0))
    
    local jsonData = HttpService:JSONEncode(data)
    
    local success, result = pcall(function()
        return HttpService:PostAsync(API_URL, jsonData, Enum.HttpContentType.ApplicationJson)
    end)
    
    if success then
        addText("✅ تم إرسال البيانات بنجاح!", Color3.fromRGB(0, 255, 0))
        addText("📋 البيانات المرسلة:", Color3.fromRGB(255, 255, 255))
        addText("👤 اللاعب: " .. data.playerName, Color3.fromRGB(200, 200, 200))
        addText("🆔 ID: " .. data.userId, Color3.fromRGB(200, 200, 200))
        addText("🎮 اللعبة: " .. data.gameName, Color3.fromRGB(200, 200, 200))
        addText("👥 عدد اللاعبين: " .. data.playerCount, Color3.fromRGB(200, 200, 200))
        addText("📡 السيرفر: " .. data.serverId, Color3.fromRGB(200, 200, 200))
    else
        addText("❌ فشل الإرسال: " .. tostring(result), Color3.fromRGB(255, 0, 0))
    end
end

SendButton.MouseButton1Click:Connect(sendData)

CloseButton.MouseButton1Click:Connect(function()
    ScreenGui:Destroy()
end)

-- إرسال تلقائي عند تشغيل السكريبت
addText("🚀 تم تشغيل Roblox Tracker", Color3.fromRGB(0, 170, 255))
sendData()
