-- وظيفة الإرسال
local function sendQuestion()
    local question = QuestionBox.Text
    if question ~= "" then
        ResponseBox.Text = "جاري التفكير..."
        SendButton.Text = "..."
        SendButton.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
        
        -- استدعاء الـ AI
        local success, result = pcall(function()
            return askAI(question)
        end)
        
        if success then
            ResponseBox.Text = result
        else
            ResponseBox.Text = "خطأ: " .. tostring(result)
        end
        
        SendButton.Text = "إرسال"
        SendButton.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
    end
end

-- ربط الأزرار
SendButton.MouseButton1Click:Connect(sendQuestion)
