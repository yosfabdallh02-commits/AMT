-- 🚀 دالة الانتقال
local function JoinServer()
    local JOB_ID = InputBox.Text:gsub("%s+", "") -- حذف المسافات
    if JOB_ID == "" then
        Status.Text = "⚠️ اكتب المعرف أولاً!"
        Status.TextColor3 = Color3.fromRGB(255, 180, 50)
        return
    end

    Status.Text = "⏳ جاري المحاولة..."
    Status.TextColor3 = Color3.fromRGB(255, 220, 80)
    GoBtn.Active = false

    local ok, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(PLACE_ID, JOB_ID, plr)
    end)

    if not ok then
        Status.Text = "❌ فشل: "..tostring(err):sub(1, 30)
        Status.TextColor3 = Color3.fromRGB(255, 80, 80)
        GoBtn.Active = true
    end
end

GoBtn.MouseButton1Click:Connect(JoinServer)
InputBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then JoinServer() end
end)

print("✅ جاهز! اكتب المعرف واضغط انضم")
